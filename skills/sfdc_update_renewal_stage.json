{
  "name": "SFDC: Update Renewal Stage",
  "description": "Open a Salesforce opportunity by DID and update its renewal stage field. Uses a saved SF session (state_sf.json) to skip the login flow.",
  "created": "2026-06-30",
  "auth_state": "state_sf.json",
  "steps": [
    {
      "action": "navigate",
      "url": "https://ciscosales.lightning.force.com"
    },
    {
      "action": "wait_for_selector",
      "selector": ".slds-global-header",
      "timeout_s": 30
    },
    {
      "action": "click",
      "selector": "button[aria-label='Search']"
    },
    {
      "action": "wait_for_selector",
      "selector": "input.search-input, input[placeholder='Search...']",
      "timeout_s": 10,
      "state": "visible"
    },
    {
      "action": "parameter_input",
      "selector": "input.search-input, input[placeholder='Search...']",
      "param_name": "did",
      "param_description": "DID number to locate the opportunity in Salesforce",
      "value": "",
      "press_enter": true
    },
    {
      "action": "locator_click",
      "label": "Click search results tab containing DID",
      "selector": "a:has-text('{did}')",
      "click_method": "js",
      "timeout_s": 30
    },
    {
      "action": "locator_click",
      "label": "Click opportunity record link (outputLookupLink)",
      "selector": "a[class*='outputLookupLink']",
      "timeout_s": 20
    },
    {
      "action": "wait_for_selector",
      "selector": ".slds-page-header",
      "timeout_s": 20
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "click",
      "selector": "button[title='Edit Stage'], a[title='Edit Stage'], [data-field='StageName'] button, button[name='StageName']"
    },
    {
      "action": "wait_for_selector",
      "selector": ".slds-combobox__container, select[name='StageName'], .slds-listbox--dropdown",
      "timeout_s": 10
    },
    {
      "action": "parameter_input",
      "selector": ".slds-combobox__container input, select[name='StageName']",
      "param_name": "renewal_stage",
      "param_description": "New renewal stage value (e.g. 'Closed Won', 'Renewal - In Progress', 'Renewal - At Risk')",
      "value": "Closed Won",
      "press_enter": false
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "click",
      "selector": "button[title='Save'], .slds-modal__footer button.slds-button_brand, .record-home-actions button[title='Save']"
    },
    {
      "action": "wait_for_selector",
      "selector": ".toastMessage, .slds-notify__content, .slds-page-header",
      "timeout_s": 15
    },
    {
      "action": "wait",
      "seconds": 1
    }
  ],
  "inputs": [
    {
      "name": "did",
      "label": "DID Number",
      "default": ""
    },
    {
      "name": "renewal_stage",
      "label": "New Renewal Stage",
      "default": "Closed Won"
    }
  ],
  "outputs": [
    {
      "name": "confirmation",
      "type": "selector",
      "selector": ".toastMessage, .slds-notify__content, .slds-page-header__title",
      "label": "Save Confirmation"
    }
  ]
}
