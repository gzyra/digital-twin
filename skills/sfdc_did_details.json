{
  "name": "SFDC: Get DID Details",
  "description": "Retrieve Salesforce opportunity details for a specific, known DID. Uses a saved SF session (state_sf.json) to skip the login flow entirely — no SSO redirect, no 35-second wait.",
  "created": "2026-06-30",
  "auth_state": "state_sf.json",
  "steps": [
    {
      "description": "Navigate to Salesforce Lightning (expects logged-in session)",
      "action": "navigate",
      "url": "https://ciscosales.lightning.force.com"
    },
    {
      "description": "Wait for global header to load",
      "action": "wait_for_selector",
      "selector": ".slds-global-header",
      "timeout_s": 30
    },
    {
      "description": "Click Search button",
      "action": "click",
      "selector": "button[aria-label='Search']"
    },
    {
      "description": "Wait for search input field to appear",
      "action": "wait_for_selector",
      "selector": "input.search-input, input[placeholder='Search...']",
      "timeout_s": 10,
      "state": "visible"
    },
    {
      "description": "Enter DID parameter into search box",
      "action": "parameter_input",
      "selector": "input.search-input, input[placeholder='Search...']",
      "param_name": "did",
      "param_description": "DID number to search for in Salesforce",
      "value": "",
      "press_enter": true
    },
    {
      "description": "Wait for search results to load",
      "action": "wait",
      "seconds": 10
    },
    {
      "description": "Click opportunity record link in search results",
      "action": "locator_click",
      "label": "Click opportunity record link",
      "selector": "a[data-special-link='true'].outputLookupLink",
      "click_method": "js",
      "timeout_s": 20
    },
    {
      "description": "Wait for page to settle",
      "action": "wait",
      "seconds": 3
    },
    {
      "description": "Click Details tab",
      "action": "locator_click",
      "label": "Click Details tab",
      "selector": "a[data-label='Details']",
      "click_method": "js",
      "timeout_s": 20
    },
    {
      "description": "Wait for Details tab content to load",
      "action": "wait_for_selector",
      "selector": ".slds-tabs_default__content.slds-show",
      "timeout_s": 20,
      "state": "visible"
    },
    {
      "description": "Final wait before extracting details",
      "action": "wait",
      "seconds": 2
    }
  ],
  "outputs": [
    {
      "name": "opportunity_details",
      "type": "selector",
      "selector": ".slds-tabs_default__content.slds-show",
      "label": "Opportunity Details",
      "parse": true,
      "fields": [
        {"name": "account_name",                    "description": "Account Name"},
        {"name": "deal_id",                         "description": "Deal id / DID number"},
        {"name": "forecasting_position",            "description": "Forecasting Position"},
        {"name": "opportunity_owner",               "description": "Opportunity Owner"},
        {"name": "opportunity_name",                "description": "Opportunity Name"},
        {"name": "stage",                           "description": "Stage"},
        {"name": "forecast_status",                 "description": "Forecast Status"},
        {"name": "opportunity_notes",               "description": "Oppty Notes / Next Steps — full text of all dated entries"},
        {"name": "close_date",                      "description": "Close Date"},
        {"name": "prior_contract_expiration_date",  "description": "Prior Contract Expiration Date"},
        {"name": "renewal_quarter_due",             "description": "Renewal Quarter Due"},
        {"name": "be_group",                        "description": "BE Group"},
        {"name": "renewal_opp_sav",                 "description": "Renewal Opp SAV"},
        {"name": "service_amount_tcv",              "description": "Service Amount TCV ($000s)"},
        {"name": "service_amount_acv",              "description": "Service Amount ACV ($000s)"},
        {"name": "service_atr",                     "description": "Service ATR ($000s)"},
        {"name": "expected_services_attrition",     "description": "Expected Services Attrition ($000s)"}
      ]
    }
  ],
  "description": "Retrieve Salesforce opportunity details for a specific, known DID. Uses a saved SF session (state_sf.json) to skip the login flow entirely — no SSO redirect, no 35-second wait.",
  "requires": ["did"],
  "provides": ["account_name", "deal_id", "forecasting_position", "opportunity_owner", "opportunity_name", "stage", "forecast_status", "opportunity_notes", "close_date", "prior_contract_expiration_date"],
  "goal_tags": ["retrieve opportunity details", "get deal info", "opportunity notes", "oppty notes", "deal details from salesforce", "renewal opportunity"],
  "system": "salesforce"
}
