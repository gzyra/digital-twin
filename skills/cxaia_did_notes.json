{
  "name": "CX AIA DID Notes",
  "created": "2026-06-17T12:56:16.678865+00:00",
  "steps": [
    {
      "description": "Navigate to CX AIA assistant",
      "action": "navigate",
      "url": "https://cxassistant.cisco.com/"
    },
    {
      "description": "Click textarea to focus",
      "action": "click",
      "selector": "textarea",
      "value": null,
      "text": "",
      "url": "https://cxassistant.cisco.com/threads"
    },
    {
      "description": "Input parameter: deal_id and send case notes prompt",
      "action": "parameter_input",
      "selector": "textarea",
      "param_name": "deal_id",
      "param_description": "The deal or opportunity ID number (digits only)",
      "template": "Summarize the case notes on a deal {deal_id}",
      "value": "69285625",
      "press_enter": true
    },
    {
      "description": "Wait for case notes to render in chat",
      "action": "wait_for_selector",
      "selector": "pol-ai-chat-message-actions button:nth-child(3)",
      "state": "visible",
      "timeout_s": 120
    },
    {
      "description": "Click export button to copy notes to clipboard",
      "action": "wait_and_click_last",
      "selector": "pol-ai-chat-message-actions button:nth-child(3)",
      "scroll_into_view": true,
      "scroll_block": "center",
      "settle_seconds": 2,
      "target": "last"
    }
  ],
  "outputs": [
    {
      "name": "did_details",
      "type": "clipboard",
      "label": "Did Details",
      "parse": true,
      "parse_instructions": "Extract the requested fields from case notes output. Preserve identifiers, names, dates, and value fields exactly. Put key narrative insights in summary without adding facts not present in source text. Return null for missing fields.",
      "fields": [
        {
          "name": "deal_id",
          "description": "Deal or opportunity ID number"
        },
        {
          "name": "customer_name",
          "description": "Customer or account name"
        },
        {
          "name": "deal_stage",
          "description": "Current stage or status of the deal"
        },
        {
          "name": "deal_value",
          "description": "Total deal value or ARR"
        },
        {
          "name": "close_date",
          "description": "Expected or actual close date"
        },
        {
          "name": "owner",
          "description": "Deal owner or account executive name"
        },
        {
          "name": "product_family",
          "description": "Main product or solution family"
        },
        {
          "name": "summary",
          "description": "Brief summary of the deal overview"
        }
      ]
    }
  ],
  "requires": ["deal_id"],
  "provides": ["deal_id", "customer_name", "deal_stage", "deal_value", "close_date", "owner", "product_family", "summary"],
  "goal_tags": ["case notes", "deal notes", "deal pulse", "ai insights", "risks", "flags", "recommendations", "deal summary", "pulse notes", "adoption risk", "next steps"],
  "system": "cxaia"
}