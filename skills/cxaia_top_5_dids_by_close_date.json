{
  "name": "TOP 10 DIDs by ATR",
  "created": "2026-06-25",
  "steps": [
    {
      "action": "navigate",
      "url": "https://cxassistant.cisco.com/"
    },
    {
      "action": "click",
      "selector": "textarea",
      "value": null,
      "text": "",
      "url": "https://cxassistant.cisco.com/threads"
    },
    {
      "action": "manual_input",
      "selector": "textarea",
      "value": "Show me my total forecast by status and top 5 opportunities by close date",
      "press_enter": true,
      "human_in_the_loop": false
    },
    {
      "action": "wait_for_selector",
      "selector": "pol-ai-chat-message-actions button:nth-child(3)",
      "state": "visible",
      "timeout_s": 120
    },
    {
      "action": "wait_and_click_last",
      "selector": "pol-ai-chat-message-actions button:nth-child(3)",
      "scroll_into_view": true,
      "scroll_block": "center",
      "settle_seconds": 2,
      "target": "last"
    }
  ],
  "outputs": [
    {
      "name": "atr_table",
      "type": "clipboard",
      "label": "Top 10 ATR Deals"
    }
  ],
  "description": "Fetch the top 5 deals sorted by close date from CX AIA. Returns a table of deal IDs, account names, close dates, and forecast status.",
  "requires": [],
  "provides": ["atr_table", "deal_id"],
  "goal_tags": ["top deals by close date", "upcoming renewals", "forecast by status", "close date"],
  "system": "cxaia"
}